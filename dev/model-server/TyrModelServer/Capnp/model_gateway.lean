  call := fun target method payload => do
    if method == infoMethod then do
      let (request, requestCaps) ← infoRequestOfPayload payload
      server.info target request requestCaps
    else if method == generateMethod then do
      let (request, requestCaps) ← generateRequestOfPayload payload
      server.generate target request requestCaps
    else if method == tokenizeMethod then do
      let (request, requestCaps) ← tokenizeRequestOfPayload payload
      server.tokenize target request requestCaps
    else if method == decodeMethod then do
