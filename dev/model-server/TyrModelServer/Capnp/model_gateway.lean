    (onMissing : Capnp.Rpc.Client -> Capnp.Rpc.Method -> Capnp.Rpc.Payload -> IO Capnp.Rpc.Payload := fun _ _ _ => pure Capnp.emptyRpcEnvelope) : Capnp.Rpc.RuntimeM ModelGateway := do
  Capnp.Rpc.RuntimeM.registerBackendTarget (backend server (onMissing := onMissing))

structure TypedServer where
  info : infoTypedHandler
  generate : generateTypedHandler
  tokenize : tokenizeTypedHandler
  decode : decodeTypedHandler

def typedDispatch (server : TypedServer) : Capnp.Rpc.Dispatch := Id.run do
  let mut d := Capnp.Rpc.Dispatch.empty
  d := Capnp.Rpc.Dispatch.register d infoMethod (fun target payload => do
    let (request, requestCaps) ← infoRequestOfPayload payload
    server.info target request requestCaps
  )
  d := Capnp.Rpc.Dispatch.register d generateMethod (fun target payload => do
    let (request, requestCaps) ← generateRequestOfPayload payload
    server.generate target request requestCaps
  )
  d := Capnp.Rpc.Dispatch.register d tokenizeMethod (fun target payload => do
    let (request, requestCaps) ← tokenizeRequestOfPayload payload
    server.tokenize target request requestCaps
  )
  d := Capnp.Rpc.Dispatch.register d decodeMethod (fun target payload => do
    let (request, requestCaps) ← decodeRequestOfPayload payload
    server.decode target request requestCaps
  )
  return d

