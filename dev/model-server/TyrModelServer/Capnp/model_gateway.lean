    { role := r.getRole
    , content := r.getContent
    }


  def ModelGateway.info_Params.ofReader (_r : ModelGateway.info_Params.Reader) : ModelGateway.info_Params :=
    {
    }


  def ModelGateway.info_Results.ofReader (r : ModelGateway.info_Results.Reader) : ModelGateway.info_Results :=
    { modelId := r.getModelId
    , source := r.getSource
    , modelDir := r.getModelDir
    , device := r.getDevice
    , maxContextTokens := r.getMaxContextTokens
    , vocabSize := r.getVocabSize
    , supportsThinking := r.getSupportsThinking
    , supportsVision := r.getSupportsVision
    }


  def ModelGateway.generate_Params.ofReader (r : ModelGateway.generate_Params.Reader) : ModelGateway.generate_Params :=
    { messages := Capnp.ListReader.toArray (Capnp.ListReader.map (fun x => ChatMessage.ofReader x) (r.getMessages))
    , maxNewTokens := r.getMaxNewTokens
    , temperature := r.getTemperature
    , topK := r.getTopK
    , topP := r.getTopP
    , enableThinking := r.getEnableThinking
    }


  def ModelGateway.generate_Results.ofReader (r : ModelGateway.generate_Results.Reader) : ModelGateway.generate_Results :=
    { text := r.getText
    , generatedTokens := Capnp.ListReader.toArray (r.getGeneratedTokens)
    , promptTokenCount := r.getPromptTokenCount
    , generatedTokenCount := r.getGeneratedTokenCount
    , stopReason := r.getStopReason
    }


  def ModelGateway.tokenize_Params.ofReader (r : ModelGateway.tokenize_Params.Reader) : ModelGateway.tokenize_Params :=
    { text := r.getText
    }


  def ModelGateway.tokenize_Results.ofReader (r : ModelGateway.tokenize_Results.Reader) : ModelGateway.tokenize_Results :=
    { tokens := Capnp.ListReader.toArray (r.getTokens)
    }


  def ModelGateway.decode_Params.ofReader (r : ModelGateway.decode_Params.Reader) : ModelGateway.decode_Params :=
    { tokens := Capnp.ListReader.toArray (r.getTokens)
    }


  def ModelGateway.decode_Results.ofReader (r : ModelGateway.decode_Results.Reader) : ModelGateway.decode_Results :=
    { text := r.getText
    }


end

end TyrModelServer.Capnp.model_gateway
