structure Server where
  info : infoHandler
  generate : generateHandler
  tokenize : tokenizeHandler
  decode : decodeHandler

def dispatch (server : Server) : Capnp.Rpc.Dispatch := Id.run do
  let mut d := Capnp.Rpc.Dispatch.empty
  d := Capnp.Rpc.Dispatch.register d infoMethod server.info
  d := Capnp.Rpc.Dispatch.register d generateMethod server.generate
  d := Capnp.Rpc.Dispatch.register d tokenizeMethod server.tokenize
  d := Capnp.Rpc.Dispatch.register d decodeMethod server.decode
  return d

def backend (server : Server)
    (onMissing : Capnp.Rpc.Client -> Capnp.Rpc.Method -> Capnp.Rpc.Payload -> IO Capnp.Rpc.Payload := fun _ _ _ => pure Capnp.emptyRpcEnvelope) : Capnp.Rpc.Backend where
  call := fun target method payload => do
    if method == infoMethod then
      server.info target payload
    else if method == generateMethod then
      server.generate target payload
    else if method == tokenizeMethod then
      server.tokenize target payload
    else if method == decodeMethod then
      server.decode target payload
    else
      onMissing target method payload

def registerTarget (runtime : Capnp.Rpc.Runtime) (server : Server)
    (onMissing : Capnp.Rpc.Client -> Capnp.Rpc.Method -> Capnp.Rpc.Payload -> IO Capnp.Rpc.Payload := fun _ _ _ => pure Capnp.emptyRpcEnvelope) : IO ModelGateway := do
  Capnp.Rpc.Runtime.registerBackendTarget runtime (backend server (onMissing := onMissing))

