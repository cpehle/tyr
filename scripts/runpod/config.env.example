# Example Runpod configuration for tyr benchmarks.
#
# Do not put RUNPOD_API_KEY in this file.
# Authenticate with `runpodctl doctor` or export RUNPOD_API_KEY in your shell.

TYR_RUNPOD_PROFILE=h100
TYR_RUNPOD_POD_NAME=tyr-h100
TYR_RUNPOD_GPU_ID="NVIDIA H100 80GB HBM3"
TYR_RUNPOD_GPU_COUNT=1

# COMMUNITY is interruptible/spot. SECURE is on-demand.
TYR_RUNPOD_CLOUD_TYPE=COMMUNITY

# Required for COMMUNITY so the workflow never bids blindly.
TYR_RUNPOD_MAX_HOURLY_USD=1.50

# Optional comma-separated affinity list. The first available H100 datacenter wins.
TYR_RUNPOD_DATA_CENTER_IDS=US-CA-2,US-KS-2,US-TX-3
TYR_RUNPOD_PREFERRED_LOCATION="United States"

# Set one of these. Template is preferred for reproducibility.
TYR_RUNPOD_TEMPLATE_ID=
TYR_RUNPOD_IMAGE=

TYR_RUNPOD_VCPU=8
TYR_RUNPOD_MEM_GB=64
TYR_RUNPOD_CONTAINER_DISK_GB=50

# Persistent cache volume. Leave the name empty to skip network-volume creation.
TYR_RUNPOD_VOLUME_NAME=tyr-runpod-cache
TYR_RUNPOD_VOLUME_SIZE_GB=200
TYR_RUNPOD_VOLUME_MOUNT_PATH=/workspace

TYR_RUNPOD_REMOTE_REPO_DIR=/workspace/tyr
TYR_RUNPOD_RESULTS_DIR=/workspace/results/tyr
TYR_RUNPOD_REMOTE_BOOTSTRAP_PACKAGES=1
